# The phone app's build variables (Vite reads these at build time). None is secret: the app ships
# them to every browser. They stay out of git anyway. Locally, copy this file to .env.local (which
# git ignores); in production they are the Cloudflare Worker's build variables
# (docs/runbooks/phone-app.md, Part 2).

# The API's address: gcloud run services describe api --region us-east4 --format 'value(status.url)'
VITE_API_URL=
# The Supabase project URL (https://<ref>.supabase.co) and its publishable key
# (Project Settings > API Keys; starts with sb_publishable_).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Off unless set to true: shows "Email me a code instead" on the sign-in screen. Needs the beta's
# email setup in Supabase first (docs/runbooks/phone-app.md, "Later").
# VITE_SIGN_IN_WITH_CODE=true
