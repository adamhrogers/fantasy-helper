{
  "components": {
    "schemas": {
      "Card": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 1000,
            "title": "Body",
            "type": "string"
          },
          "data": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Data",
            "type": "object"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "items": {
            "default": [],
            "items": {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "title": "Items",
            "type": "array"
          },
          "kind": {
            "$ref": "#/components/schemas/CardKind"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "recommendation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Id"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "body"
        ],
        "title": "Card",
        "type": "object"
      },
      "CardKind": {
        "enum": [
          "move",
          "lock_or_pass",
          "signal",
          "recap",
          "league_moves",
          "news",
          "matchup",
          "self_review",
          "report_card"
        ],
        "title": "CardKind",
        "type": "string"
      },
      "GameDay": {
        "additionalProperties": false,
        "description": "The NBA schedule for one date, the same for every league: how many games, and when the\nfirst tips. The phone shows it once at the top of a day's reports.",
        "properties": {
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "first_tip_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Tip Utc"
          },
          "games": {
            "minimum": 0.0,
            "title": "Games",
            "type": "integer"
          }
        },
        "required": [
          "day",
          "games"
        ],
        "title": "GameDay",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "JsonValue": {},
      "LeagueOut": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "platform": {
            "title": "Platform",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "platform"
        ],
        "title": "LeagueOut",
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "properties": {
          "leagues": {
            "items": {
              "$ref": "#/components/schemas/LeagueOut"
            },
            "title": "Leagues",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "name",
          "timezone",
          "leagues"
        ],
        "title": "Me",
        "type": "object"
      },
      "PushKey": {
        "additionalProperties": false,
        "properties": {
          "public_key": {
            "title": "Public Key",
            "type": "string"
          }
        },
        "required": [
          "public_key"
        ],
        "title": "PushKey",
        "type": "object"
      },
      "PushKeys": {
        "additionalProperties": false,
        "properties": {
          "auth": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Auth",
            "type": "string"
          },
          "p256dh": {
            "maxLength": 256,
            "minLength": 1,
            "title": "P256Dh",
            "type": "string"
          }
        },
        "required": [
          "p256dh",
          "auth"
        ],
        "title": "PushKeys",
        "type": "object"
      },
      "ReportDocument": {
        "additionalProperties": false,
        "properties": {
          "cards": {
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "title": "Cards",
            "type": "array"
          },
          "engine_only": {
            "default": false,
            "title": "Engine Only",
            "type": "boolean"
          },
          "for_date": {
            "format": "date",
            "title": "For Date",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ReportKind"
          },
          "league_id": {
            "format": "uuid",
            "title": "League Id",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "league_id",
          "kind",
          "for_date",
          "generated_at",
          "cards"
        ],
        "title": "ReportDocument",
        "type": "object"
      },
      "ReportKind": {
        "enum": [
          "daily",
          "weekly",
          "scorecard"
        ],
        "title": "ReportKind",
        "type": "string"
      },
      "ReportsOut": {
        "additionalProperties": false,
        "properties": {
          "for_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "For Date"
          },
          "games": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameDay"
              },
              {
                "type": "null"
              }
            ]
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/ReportDocument"
            },
            "title": "Reports",
            "type": "array"
          }
        },
        "required": [
          "for_date",
          "reports"
        ],
        "title": "ReportsOut",
        "type": "object"
      },
      "SubscriptionIn": {
        "additionalProperties": false,
        "description": "The shape a browser's `PushSubscription.toJSON()` gives.",
        "properties": {
          "endpoint": {
            "maxLength": 2048,
            "minLength": 12,
            "pattern": "^https://",
            "title": "Endpoint",
            "type": "string"
          },
          "keys": {
            "$ref": "#/components/schemas/PushKeys"
          }
        },
        "required": [
          "endpoint",
          "keys"
        ],
        "title": "SubscriptionIn",
        "type": "object"
      },
      "SubscriptionOut": {
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "title": "Endpoint",
            "type": "string"
          }
        },
        "required": [
          "endpoint"
        ],
        "title": "SubscriptionOut",
        "type": "object"
      },
      "SubscriptionRemove": {
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "maxLength": 2048,
            "minLength": 12,
            "title": "Endpoint",
            "type": "string"
          }
        },
        "required": [
          "endpoint"
        ],
        "title": "SubscriptionRemove",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Fantasy Helper API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/livez": {
      "get": {
        "operationId": "livez_livez_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Livez",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "app"
        ]
      }
    },
    "/v1/push/public-key": {
      "get": {
        "operationId": "push_public_key_v1_push_public_key_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushKey"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Push Public Key",
        "tags": [
          "push"
        ]
      }
    },
    "/v1/push/subscriptions": {
      "delete": {
        "operationId": "remove_subscription_v1_push_subscriptions_delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionRemove"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Remove Subscription",
        "tags": [
          "push"
        ]
      },
      "put": {
        "operationId": "save_subscription_v1_push_subscriptions_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Save Subscription",
        "tags": [
          "push"
        ]
      }
    },
    "/v1/reports/{kind}": {
      "get": {
        "description": "The latest reports of this kind (or those of one date), one per league: one query. Daily\nreports come with that date's games (how many, and when the first tips), from the same query.",
        "operationId": "get_reports_v1_reports__kind__get",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "enum": [
                "daily",
                "weekly"
              ],
              "title": "Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Reports",
        "tags": [
          "app"
        ]
      }
    }
  }
}
