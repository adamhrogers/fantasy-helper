# Fantasy Helper: SYSTEM settings and secrets only.
#
# User and league data (league IDs, ESPN cookies, friends) never go here. They live in the
# database, and platform logins are stored encrypted (docs/architecture.md §12.1).
#
# Copy this file to .env (git-ignored) and fill it in. Values in .env are read by the app only;
# they are never exported to your shell. Production values live in GitHub Secrets.

FH_ENV=dev
FH_LOG_LEVEL=INFO
FH_LOG_JSON=false

# Supabase: Connect > Connection string > "Session pooler" (works from GitHub Actions).
DATABASE_URL=

# Encrypts platform logins. Generate with: uv run fh keygen   (use a different key per env)
FH_ENCRYPTION_KEY=

# LangSmith: Settings > API Keys
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fantasy-helper
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU accounts
LANGSMITH_API_KEY=

# Run events via ntfy (docs/runbooks/run-events.md). Anyone who knows the topic can read it, so
# keep it random: generate with: uv run fh keygen --topic, then subscribe in the ntfy phone app.
# FH_NOTIFY_PROGRESS=false turns off the quiet events (started, steps, succeeded); failures and
# warnings are always sent.
FH_NOTIFY_PROGRESS=true
FH_NTFY_SERVER=https://ntfy.sh
FH_NTFY_TOPIC=

# The missed-run watchdog (ADR 0025). Only the scheduled Cloud Run jobs set it, from Secret
# Manager; leave it empty here, so runs on the laptop never ping.
FH_HEALTHCHECKS_PING_KEY=

# Local working folder (git-ignored): raw snapshots when FH_RAW_STORE=local, and report pages.
FH_DATA_DIR=data

# Raw snapshot store (ADR 0023): local (FH_DATA_DIR/raw) or r2 (the shared Cloudflare bucket).
# The R2 values come from the R2 API token (docs/runbooks/m3-account-setup.md, section 4).
# `fh raw upload` needs them even while FH_RAW_STORE=local.
FH_RAW_STORE=local
FH_R2_ENDPOINT=
FH_R2_ACCESS_KEY_ID=
FH_R2_SECRET_ACCESS_KEY=
# FH_R2_BUCKET=fantasy-helper-raw

# Claude API key for the nightly pipeline (from M4). Deliberately NOT ANTHROPIC_API_KEY, so it
# can't leak into the shell you run Claude Code in. Set a monthly spend limit in the Console.
FH_ANTHROPIC_API_KEY=
